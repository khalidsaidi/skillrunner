{
  "name": "skillrunner",
  "private": true,
  "version": "0.1.3",
  "description": "SkillRunner monorepo: CLI + engine + registry of reusable engineering skills",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm registry:build && pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "registry:build": "node packages/registry-tools/src/build-index.mjs",
    "registry:validate": "node packages/registry-tools/src/validate.mjs"
  },
  "devDependencies": {
    "eslint": "^9.14.0",
    "prettier": "3.5.3",
    "typescript-eslint": "^8.13.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
