{
  "name": "@khalidsaidi/skillrunner",
  "version": "0.1.3",
  "description": "Local-first CLI to discover, install, plan, and safely run reusable engineering skills.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/khalidsaidi/skillrunner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khalidsaidi/skillrunner.git"
  },
  "bugs": {
    "url": "https://github.com/khalidsaidi/skillrunner/issues"
  },
  "keywords": [
    "cli",
    "skills-cli",
    "automation",
    "developer-tools",
    "engineering-workflows",
    "devops-automation",
    "local-first",
    "agent-workflows",
    "skill-registry",
    "code-review",
    "testing",
    "terraform",
    "react"
  ],
  "bin": {
    "skill": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && node scripts/copy-bundled-registry.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "ora": "^8.1.0",
    "prompts": "^2.4.2",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@khalidsaidi/skillrunner-engine": "workspace:*",
    "@types/node": "^20.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
