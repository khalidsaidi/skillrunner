{
  "name": "@khalidsaidi/skillrunner",
  "version": "0.2.0",
  "description": "Audit, safely run, and export SKILL.md agent skills across Claude Code, Codex, Cursor, and opencode.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/khalidsaidi/skillrunner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khalidsaidi/skillrunner.git"
  },
  "bugs": {
    "url": "https://github.com/khalidsaidi/skillrunner/issues"
  },
  "keywords": [
    "cli",
    "skills",
    "skill-md",
    "agent-skills",
    "claude-code",
    "codex",
    "cursor",
    "opencode",
    "audit",
    "supply-chain-security",
    "developer-tools",
    "local-first",
    "agent-workflows",
    "skill-registry"
  ],
  "bin": {
    "skill": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && node scripts/copy-bundled-registry.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "ora": "^8.1.0",
    "prompts": "^2.4.2",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@khalidsaidi/skillrunner-engine": "workspace:*",
    "@types/node": "^20.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
